# SmolVLA sort-cubes, replication of Orellius smolvla_base_100k recipe (BS 32, fp32, transforms, 100k).
#! trainer: lerobot-train
#! include: _smolvla_sort_cubes
--dataset.image_transforms.enable=true
--policy.load_vlm_weights=false
--policy.vlm_model_name=HuggingFaceTB/SmolVLM2-500M-Video-Instruct
--policy.use_amp=false
--policy.n_action_steps=50
--batch_size=32
--scheduler.num_decay_steps=200000
--scheduler.num_warmup_steps=10000
--steps=100000
--save_freq=5000
--seed=1000
--num_workers=8
