# Cosmos-Predict2-2B T=2 online, cube v1, no augmentation, step-6000 video-LoRA (alpha from sidecar).
# Validates with the online extractor unless you pass a cache built with the SAME LoRA/alpha/sigma.
#! include: _smolexpert_online_base
#! include: _cube_v1
--online-backbone cosmos2b
--backbone-checkpoint /home/anton/.cache/video-vam/mimic-video-f2833903/video_backbone/v2w_pretrained_cosmos.pt
--backbone-tokenizer /home/anton/.cache/video-vam/mimic-video-f2833903/video_backbone/tokenizer/tokenizer.pth
--backbone-prompt-embedding /home/anton/.cache/video-vam/prompt-embeddings/cube-out-of-box-t5-11b.safetensors
--backbone-lora-weights outputs/train/cosmos-video-lora-step6000/best_lora.safetensors
--backbone-layer 20
--high-noise-sigma 80.0
--no-augment
--compile-loss
